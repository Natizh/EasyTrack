    "Use a positive amount; the transaction type sets its direction.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un importo positivo; il tipo di movimento ne determina la direzione."
          }
        }
      }
    },
    "Use a short stable label, for example “Northstar Bank”. Do not enter a username, password, card number, or OTP.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un'etichetta breve e stabile, per esempio “Northstar Bank”. Non inserire utente, password, numero di carta o OTP."
          }
        }
      }
    },
    "Use a short valid advanced pattern.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa uno schema avanzato breve e valido."
          }
        }
      }
    },
    "Use fixed wording such as “paid” or “received” above to identify this format. Different wording can have another format rule.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa sopra parole ricorrenti come “pagato” o “ricevuto” per identificare il formato. Per testi diversi puoi creare un'altra regola."
          }
        }
