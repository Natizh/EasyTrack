      }
    },
    "Troubleshooting": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risoluzione dei problemi"
          }
        }
      }
    },
    "Try fictional notification": {
      "localizations": {
