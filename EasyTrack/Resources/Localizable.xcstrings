    "A file in iCloud Drive is a snapshot, not live device synchronization.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un file in iCloud Drive è una copia, non una sincronizzazione continua tra dispositivi."
