            "value": "Viaggio"
          }
        }
      }
    },
    "Trip membership is explicit. Dates never add or remove transactions automatically, so advance bookings remain included.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appartenenza al viaggio è esplicita. Le date non aggiungono né rimuovono movimenti automaticamente, quindi le prenotazioni anticipate restano incluse."
